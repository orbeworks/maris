{
  "expo": {
    "name": "Maris",
    "slug": "maris",
    "version": "1.0.0",
    "icon": "./assets/app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/app-icon.png",
      "supportsTablet": true,
      "appleTeamId": "J728Z86KY5",
      "bundleIdentifier": "com.orbeworks.maris"
    },
    "android": {
      "icon": "./assets/app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#064CA0"
      },
      "package": "com.maris.navigation"
    },
    "plugins": [
      "./plugins/with-ios-app-variants",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Maris usa sua localização para mostrar sua posição e direção no mapa."
        }
      ]
    ]
  }
}
